# ==============================================================================
# Resono Production Environment Configuration (.env.example)
# Copy this file to .env and adjust values to suit your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Jellyfin Storage Paths (Turnkey All-in-One Stack)
# ------------------------------------------------------------------------------
# Host directories mounted into the Jellyfin container.
JELLYFIN_CONFIG_DIR=./config/jellyfin
JELLYFIN_CACHE_DIR=./cache/jellyfin
JELLYFIN_MEDIA_DIR=./media/music

# Automatic plugin updates on container restart (true / false)
RESONO_AUTO_UPDATE_PLUGIN=false

# ------------------------------------------------------------------------------
# 2. Resono Gateway Core Settings
# ------------------------------------------------------------------------------
RESONO_HOST=0.0.0.0
RESONO_PORT=8080
RESONO_DEBUG=false

# ------------------------------------------------------------------------------
# 3. Audio Streaming & Acquisition Providers
# ------------------------------------------------------------------------------
# Primary audio streaming source ('deezer', 'slskd', or 'none')
# Default is 'deezer' which provides instant, zero-wait on-demand playback.
RESONO_PRIMARY_PLAYBACK_SOURCE=deezer

# Optional fallback audio provider if the primary provider fails ('deezer', 'slskd', 'none')
RESONO_FALLBACK_PLAYBACK_SOURCE=none

# Deezer ARL Token (Optional)
# Leave blank for default 128kbps MP3 streaming.
# Enter your Deezer ARL cookie value for high-bitrate (320kbps MP3) and Lossless (FLAC 16-bit / 44.1kHz).
# How to get your ARL: Log in to Deezer Web, open DevTools -> Application/Storage -> Cookies -> copy 'arl' value.
RESONO_DEEZER_ARL=

# ------------------------------------------------------------------------------
# 4. Storage, Database & Cache Management
# ------------------------------------------------------------------------------
# SQLite WAL database connection string
RESONO_DATABASE_URL=sqlite+aiosqlite:///./data/resono.db

# Storage directories inside Gateway container
RESONO_DATA_DIR=/app/data
RESONO_CACHE_DIR=/app/cache/audio
RESONO_ARTWORK_DIR=/app/cache/artwork

# Maximum local audio cache size in Gigabytes before LRU pruning triggers
RESONO_MAX_CACHE_SIZE_GB=25.0

# Minimum free disk space in Gigabytes to preserve on the host volume
RESONO_MIN_FREE_DISK_GB=10.0

# Concurrent acquisition and pre-fetch buffers
RESONO_MAX_CONCURRENT_DOWNLOADS=3
RESONO_PREFETCH_BUFFER_TRACKS=2

# ------------------------------------------------------------------------------
# 5. Audio Matching & Anti-Cover Scoring
# ------------------------------------------------------------------------------
# Confidence threshold for matching songs across providers (0.0 to 1.0)
RESONO_MATCHER_CONFIDENCE_THRESHOLD=0.80

# Maximum duration deviation in milliseconds (6000ms = 6s tolerance)
RESONO_MAX_DURATION_DIFFERENCE_MS=6000

# ------------------------------------------------------------------------------
# 6. Spotify Catalog Metadata (Optional)
# ------------------------------------------------------------------------------
# Resono operates in zero-credential mode by default using Apple Music and Deezer public APIs.
# You can optionally provide Spotify API credentials for enhanced playlist import.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. Soulseek / slskd Acquisition (Optional)
# ------------------------------------------------------------------------------
# Required only if using 'slskd' as primary or fallback playback source.
RESONO_SOULSEEK_BACKEND=slskd
RESONO_SLSKD_URL=http://slskd:5030
RESONO_SLSKD_API_KEY=
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=



