# ==============================================================================
# Resono Production Environment Configuration (.env.example)
# Copy this file to .env or configure these variables in Dokploy.
# NEVER commit real credentials to your Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# Resono Gateway Core Settings
# ------------------------------------------------------------------------------
RESONO_HOST=0.0.0.0
RESONO_PORT=8080
RESONO_DEBUG=false

# Soulseek Backend Selection ('slskd' is the production daemon)
RESONO_SOULSEEK_BACKEND=slskd

# URL where Gateway accesses the existing production slskd daemon on the Docker host
RESONO_SLSKD_URL=http://host.docker.internal:5030

# Optional API Key if configured on slskd (leave blank if authentication is disabled)
RESONO_SLSKD_API_KEY=

# Daemon communication timeouts (seconds)
RESONO_SLSKD_TIMEOUT_SECONDS=15
RESONO_SLSKD_SEARCH_TIMEOUT_SECONDS=6

# Path inside Gateway container where slskd downloads must be accessed
# (Requires shared filesystem mount between host slskd and Gateway for acquisition to complete)
RESONO_SLSKD_DOWNLOADS_PATH=/downloads

# ------------------------------------------------------------------------------
# Storage, Database & Cache Settings
# ------------------------------------------------------------------------------
# SQLite WAL database connection string
RESONO_DATABASE_URL=sqlite+aiosqlite:///./data/resono.db

# Storage directories inside Gateway container
RESONO_DATA_DIR=/app/data
RESONO_CACHE_DIR=/app/cache/audio
RESONO_ARTWORK_DIR=/app/cache/artwork

# Cache management limits
RESONO_MAX_CACHE_SIZE_GB=50.0
RESONO_MIN_FREE_DISK_GB=10.0
RESONO_MAX_CONCURRENT_DOWNLOADS=3
RESONO_PREFETCH_BUFFER_TRACKS=2

# Audio Matcher Confidence Threshold (0.0 to 1.0)
RESONO_MATCHER_CONFIDENCE_THRESHOLD=0.80
RESONO_MAX_DURATION_DIFFERENCE_MS=6000

# ------------------------------------------------------------------------------
# Spotify Catalog Metadata Provider (SpotAPI)
# ------------------------------------------------------------------------------
# SpotAPI operates in zero-credential mode by default (no credentials required).
# Optionally provide official Spotify Web API credentials for higher rate limits.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


